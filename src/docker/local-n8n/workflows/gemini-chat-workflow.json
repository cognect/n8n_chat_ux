        {
            "parameters": {
                "jsCode": "// Extract message and sessionId from incoming request\nconst body = $input.first().json.body || $input.first().json;\nconst message = body.message || body.text || '';\nconst sessionId = body.sessionId || 'default-session';\n\nconsole.log('Received message:', message, 'Session:', sessionId);\n\nreturn [{\n  json: {\n    message: message,\n    sessionId: sessionId\n  }\n}];"
            },
            "id": "422f0749-d7d1-472f-9ddf-33c4693b416a",
            "name": "Prepare Request",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                368,
                -272
            ]
        },
        {
            "parameters": {
                "jsCode": "// Extract response from AI Agent output\nconst input = $input.first().json;\nlet response = '';\n\n// AI Agent outputs to 'output' field\nif (input.output) {\n    response = input.output;\n} else if (input.text) {\n    response = input.text;\n}\n\n// Build SSE formatted response\nlet sseResponse = 'event: workflow:start\\ndata: {}\\n\\n';\nconst dataPayload = JSON.stringify({ content: response });\nsseResponse += 'event: data\\ndata: ' + dataPayload + '\\n\\n';\nsseResponse += 'event: workflow:end\\ndata: {}\\n\\n';\n\nreturn [{\n  json: {\n    sseResponse: sseResponse\n  }\n}];"
            },
            "id": "54aa40d0-af32-4e4b-9cc5-ca57913f979c",
            "name": "Format SSE Response",
